{
  "name": "edubox-devices",
  "version": "1.0.0",
  "description": "EduBox sensor and actuator implementations",
  "keywords": ["edubox", "sensors", "actuators"],
  "frameworks": ["arduino"],
  "platforms": ["espressif32"],
  "dependencies": {
    "edubox-engine": "*",
    "OneWire": "*",
    "DallasTemperature": "*",
